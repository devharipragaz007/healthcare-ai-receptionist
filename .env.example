DATABASE_URL="file:./dev.db"

# OpenAI API key — used by:
#   • Pipecat voice server (gpt-4o-realtime-preview) — set in voice-server/.env
#   • Next.js server (gpt-4o-mini) — AI visit summary generation (Phase 6)
# If absent, visit summaries fall back to "Summary unavailable." gracefully.
OPENAI_API_KEY=""

# App base URL — used for absolute links if needed
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WebSocket URL of the running Pipecat voice server
# The browser connects here to stream audio and receive transcripts
NEXT_PUBLIC_PIPECAT_SERVER_URL="ws://localhost:8765"
