# OpenAI API key — required for OpenAI Realtime (gpt-4o-realtime-preview)
OPENAI_API_KEY=your-openai-api-key-here

# URL of the running Next.js app — used to call /api/tools/* endpoints
NEXT_APP_URL=http://localhost:3000

# Port the Pipecat WebSocket server listens on (browser connects here)
PIPECAT_PORT=8765
